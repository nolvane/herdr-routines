# Settings for the herdr-routines plugin. Copy to the plugin's config directory
# (`herdr plugin config-dir herdr-routines`) as config.toml. Every line is optional;
# these are the defaults.

# The workspace runs open in; created when missing.
workspace = "Routines"

# Close the tab of a finished run after this many minutes (0 keeps them).
close_finished_after_minutes = 60

# Also notify when a run finishes, not only when it needs you.
notify_finished = false

# How many runs Herdr starts side by side. Further ones wait for a free
# place and start when a run ends (0 = no limit). A run that waits for your
# answer takes no place; runs started by hand and cron jobs do not count.
max_parallel = 3

# "nerd" for Nerd Font icons, "plain" for plain symbols.
icons = "nerd"

# Where the "open" action shows the list: "overlay", "split" or "tab".
placement = "overlay"

# The side of a split: "down", "up", "left" or "right".
split_direction = "down"
